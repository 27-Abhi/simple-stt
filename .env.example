# Leave blank to use local SQLite (stt.db), or set a PostgreSQL URL:
# DATABASE_URL=postgresql://stt:sttpassword@localhost:5432/stt
DATABASE_URL=

# Optional: enables Gemini Live real-time WebSocket transcription
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025

# Optional: Whisper model size if faster-whisper is installed
WHISPER_MODEL=base
